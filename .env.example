# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DEMO_MODE=true

# Public app URL, for example https://daily-bot.example.com
PUBLIC_BASE_URL=

# Odoo
ODOO_BASE_URL=https://abmapex.ru
ODOO_DATABASE=
ODOO_API_STYLE=auto
ODOO_API_KEY=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_DEFAULT_USER_ID=0
ODOO_VERIFY_SSL=true

# AI provider
OPENAI_API_KEY=
AI_MODEL=gpt-5.1-mini

# Comma-separated Telegram numeric user IDs allowed to use management commands
PM_TELEGRAM_IDS=
TECH_LEAD_TELEGRAM_IDS=

# Database
DATABASE_URL=postgresql+asyncpg://abm_bot:abm_bot@localhost:5432/abm_bot

# Runtime
APP_ENV=local
LOG_LEVEL=INFO
TIMEZONE=Asia/Yekaterinburg

