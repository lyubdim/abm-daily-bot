# Copy this file to deploy/production.env on the server and set chmod 600.
# Never commit production.env.

TELEGRAM_BOT_TOKEN=
DEMO_MODE=true
TIMEZONE=Asia/Yekaterinburg
LOG_LEVEL=INFO

POSTGRES_DB=abm_bot
POSTGRES_USER=abm_bot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://abm_bot:replace-with-url-encoded-password@postgres:5432/abm_bot

ODOO_BASE_URL=https://abmapex.ru
ODOO_DATABASE=
ODOO_API_STYLE=auto
ODOO_API_KEY=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_VERIFY_SSL=true

OPENAI_API_KEY=
AI_MODEL=gpt-5.1-mini

